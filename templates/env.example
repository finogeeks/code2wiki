# Non-secret knobs for the casst appliance site.
# Secrets go in ./secrets/ (never commit them).

CODE2WIKI_PORT=8080
# If :8080 is already taken (another appliance), pick a free host port:
# CODE2WIKI_PORT=18080
# and set CASST_PUBLIC_BASE_URL=http://127.0.0.1:18080

# Published default (override for local dogfood):
# CODE2WIKI_IMAGE=ghcr.io/finogeeks/code2wiki:latest
# CODE2WIKI_IMAGE=code2wiki:dev

# When running a second site on the same Docker host, isolate Compose.
# init-site / get-started set this to casst-<pack> by default.
# COMPOSE_PROJECT_NAME=casst-acme

CASST_RUNTIME=finclaw
CASST_MOCK=0

# Safer first boot until pack is activated + remotes work.
# After activate, run ./scripts/ingest.sh (or set these to 1 and recreate).
CODE2WIKI_RECONCILE=0
CODE2WIKI_AUTO_WARM=0

# Where the facade loads the capability ledger (must match the answer-cache mount).
CASST_LEDGER_ROOT=/var/lib/code2wiki/answer-cache/wiki/capabilities

LLM_PROVIDER=openai
LLM_MODEL=gpt-4.1
LLM_BASE_URL=

# CODE2WIKI_PROFILE is set by ./scripts/activate.sh

# Ask timeout seconds (LLM turns can be slow on first call):
# CODE2WIKI_ASK_TIMEOUT=180

# Operator console publish (optional):
# CASST_OPERATOR_TOKEN=change-me

# Lightweight local smoke without curator spend:
# CASST_MOCK=1
# CODE2WIKI_AUTO_WARM=0
# CODE2WIKI_RECONCILE=0
